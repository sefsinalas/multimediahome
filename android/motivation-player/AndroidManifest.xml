<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="ar.com.flowbox.office">
  <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="29" />
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-feature android:name="android.software.leanback" android:required="false" />
  <application android:label="Panel de oficina" android:theme="@android:style/Theme.Material.NoActionBar" android:usesCleartextTraffic="false" android:requestLegacyExternalStorage="true">
    <activity android:name="ar.com.flowbox.motivation.MainActivity" android:exported="true" android:screenOrientation="landscape">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
      </intent-filter>
    </activity>
  </application>
</manifest>
